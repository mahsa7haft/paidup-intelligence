# Combined VPS deployment config. Copy to `.env` and fill in.
#   cp .env.example .env
# Compose reads this file automatically. Never commit the real .env.

# ── Database passwords (pick strong values; used to build the internal URLs) ──
PAIDUP_DB_PASSWORD=change-me-paidup
INTELLIGENCE_DB_PASSWORD=change-me-intelligence

# ── API keys ──────────────────────────────────────────────────────────────
# PaidUp: AI analysis + donor classification
ANTHROPIC_API_KEY=sk-ant-...
# PaidUp Intelligence: embeddings (text-embedding-3-small) for ingestion + agent
OPENAI_API_KEY=sk-...
# Optional — voting record / APPG data (free at theyworkforyou.com/api/key)
THEYWORKFORYOU_API_KEY=

# PaidUp Flask session secret — set a long random string
FLASK_SECRET_KEY=change-me-in-production

# ── Domains (only needed for the `tls` profile / Caddy HTTPS) ────────────────
# Leave blank for IP-only access on ports 5002 / 5003.
PAIDUP_DOMAIN=
INTELLIGENCE_DOMAIN=

# ── Optional: PaidUp R2 card-image CDN (leave blank to serve cards from Flask) ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Optional: Langfuse LLM observability ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Optional: cap public /ask spend (per-IP questions/hour; 0 disables) ──────
RATE_LIMIT_PER_HOUR=30
